DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Leave DATABASE_URL empty to use SQLite. Example: postgres://user:pass@localhost:5432/promokote
DATABASE_URL=

# Upstream platform (the system Promokote is built on top of)
UPSTREAM_BASE_URL=https://emailbackend.tarxemo.com/api/v1
UPSTREAM_API_KEY=
UPSTREAM_API_SECRET=
# When True (default if keys are empty) nothing real is sent; messages are simulated.
UPSTREAM_FAKE=

# Interface language for new visitors (sw = Kiswahili, en = English)
APP_DEFAULT_LANGUAGE=sw

# Free demo SMS given once to every new organisation
DEMO_SMS_CREDITS=10
DEMO_SMS_SENDER_ID=PROMOKOTE
DEMO_REQUIRE_VERIFIED_EMAIL=True
DEMO_MAX_CLAIMS_PER_IP_PER_DAY=3
DEMO_MAX_PER_RECIPIENT_PER_DAY=5
# Set True only when running behind your own reverse proxy that sets X-Forwarded-For
TRUST_X_FORWARDED_FOR=False
# Sender field name on upstream /send-sms/ (leave empty if upstream has no sender field)
UPSTREAM_SMS_SENDER_FIELD=
