# Production environment for Promokote
# Copy this file to ~/promokote-deploy/.env on the server and fill in real values.

# ── Django ─────────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

DJANGO_DEBUG=False

# Your actual domain(s) — comma-separated, no spaces
DJANGO_ALLOWED_HOSTS=api.promokote.com

# CORS — must include the frontend origin
CORS_ALLOWED_ORIGINS=https://promokote.com,https://www.promokote.com
FRONTEND_URL=https://promokote.com
PUBLIC_BASE_URL=https://api.promokote.com

# ── Database (Postgres container) ──────────────────────────────────────────────
# DATABASE_URL is built from the individual vars below by docker-compose.prod.yml.
# The backend reads DATABASE_URL; docker-compose passes DB_* to Postgres init.
DB_NAME=promokote
DB_USER=promokote
DB_PASSWORD=your-strong-password-here
# Set DATABASE_URL using the same password you chose above
DATABASE_URL=postgresql://promokote:your-strong-password-here@db:5432/promokote

# ── Upstream SMS/Email platform ────────────────────────────────────────────────
UPSTREAM_BASE_URL=https://emailbackend.tarxemo.com/api/v1
UPSTREAM_API_KEY=
UPSTREAM_API_SECRET=
# Leave blank — auto-detected from keys above (True if keys are empty)
UPSTREAM_FAKE=
